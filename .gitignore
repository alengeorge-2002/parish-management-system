# ==========================================
# Root .gitignore for Parish Management System
# ==========================================

# Dependencies
node_modules/
*/node_modules/
*/*/node_modules/

# Environment files & secrets
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example
!.env.*.example
!*/**/.env.example

# Build outputs
dist/
dist-ssr/
build/
web-build/
android-build/
*.tsbuildinfo
.cache/
.vite/
vite.config.*.timestamp-*

# Expo & React Native
.expo/
.kotlin/
*.apk
*.aab
*.jks
*.p8
*.p12
*.key
*.mobileprovision
frontend/ios/
frontend/android/
.metro-health-check*

# Backend uploads (keep directories via .gitkeep)
backend/uploads/**
!backend/uploads/
!backend/uploads/**/
!backend/uploads/**/.gitkeep

# Temporary / Scratch files
scratch/
backend/scratch_*.txt
*.ext4
.tmp-*
.claude-replay.*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# System & OS Files
.DS_Store
Thumbs.db
ehthumbs.db

# IDE & Editor files
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
